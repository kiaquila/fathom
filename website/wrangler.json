{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fathom",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-03",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
